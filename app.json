{
  "expo": {
    "name": "Caderno Gastronômico",
    "slug": "caderno-gastronomico",
    "scheme": "cadernogastronomico",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Permite selecionar fotos de capa e vídeos de preparo das suas receitas."
      }
    },
    "android": {
      "package": "com.rober.cadernogastronomico",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "androidIntentFilters": [
            "text/*"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "63d09031-ce89-4fd6-b72b-283ced987e61"
      }
    }
  }
}
